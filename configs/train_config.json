{
    "model_config": {
        "model_name": "gpt2-medium (355M)",
        "vocab_size": 50257,
        "context_length": 1024,
        "drop_rate": 0.01,
        "qkv_bias": true,
        "num_layers": 6,
        "num_heads": 8,
        "d_model": 768,
        "max_seq_len": 512,
        "dropout": 0.01,
        "image_embedding_dim": 2048,
        "test_mode": true,
        "test_size": 200
    },
    "data_config": {
        "train_file": "data/processed/train.json",
        "val_file": "data/processed/val.json",
        "test_file": "data/processed/test.json",
        "image_dir": "data/processed/images",
        "cache_dir": "data/processed/image_cache",
        "batch_size": 4,
        "gradient_accumulation_steps": 8,
        "num_workers": 0,
        "pin_memory": true,
        "number_of_items_to_predict": 10,
        "min_interactions": 3,
        "user_prompt": "Given a user's purchase history and review for a product, predict the next 10 products they would likely purchase. "
    },
    "training_config": {
        "num_epochs": 5,
        "learning_rate": 5e-6,
        "min_learning_rate": 1e-6,
        "weight_decay": 0.1,
        "max_grad_norm": 1.0,
        "save_every": 1,
        "pad_token_id": 50256,
        "early_stopping_patience": 5,
        "early_stopping_min_delta": 0.001,
        "warmup_steps": 1000,
        "fp16": true,
        "seed": 42,
        "log_dir": "logs",
        "prompt_template": "phi3",
        "lora": true,
        "lora_rank": 8,
        "lora_alpha": 0.5,
        "eval_freq": 5,
        "eval_iter": 5,
        "temperature": 0.5,
        "top_k": 20,
        "top_p": 0.8,
        "max_new_tokens": 100
    },
    "checkpoint_dir": "checkpoints",
    "data_split_ratio": {
        "train_ratio": 0.7,
        "val_ratio": 0.15,
        "test_ratio": 0.15
    },
    "gpt_model_config": {
        "gpt2-small (124M)": {"emb_dim": 768, "n_layers": 12, "n_heads": 12},
        "gpt2-medium (355M)": {"emb_dim": 1024, "n_layers": 24, "n_heads": 16},
        "gpt2-large (774M)": {"emb_dim": 1280, "n_layers": 36, "n_heads": 20},
        "gpt2-xl (1558M)": {"emb_dim": 1600, "n_layers": 48, "n_heads": 25}
    },
    "custom_config": {
        "phi3": true, 
        "alpaca": false,
        "lora": false
    }
} 